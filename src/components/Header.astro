---
import { categorieen } from '../data/categorieen';
import { withBase } from '../utils/url';

const pad = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href={withBase('')} class="logo">
      🎁 <span>CadeauGids</span>
    </a>

    <nav aria-label="Hoofdnavigatie" class="nav">
      <ul>
        {
          categorieen.map((cat) => {
            const href = withBase(`cadeaus/${cat.slug}/`);
            const actief = pad === href;
            return (
              <li>
                <a href={href} aria-current={actief ? 'page' : undefined}>
                  {cat.titel.replace(/^Cadeaus voor /, '').replace(/^Verjaardagscadeaus voor /, '')}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-card-bg);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.9rem;
  }

  .logo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.3rem;
    text-decoration: none;
    color: var(--color-text);
    display: flex;
    align-items: center;
    gap: 0.4em;
    white-space: nowrap;
  }

  .nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    margin: 0;
    padding: 0;
  }

  .nav a {
    text-decoration: none;
    color: var(--color-text-muted);
    font-weight: 600;
    font-size: 0.92rem;
    padding: 0.3em 0;
    border-bottom: 2px solid transparent;
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--color-primary-dark);
    border-color: var(--color-primary);
  }

  @media (max-width: 720px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
