---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import CategoryFilters from '../../../components/CategoryFilters.astro';
import { categorieen } from '../../../data/categorieen';

export async function getStaticPaths() {
  return categorieen.map((categorie) => ({
    params: { categorie: categorie.slug },
    props: { categorie },
  }));
}

const { categorie } = Astro.props;

const alleProducten = await getCollection('producten', (entry) => entry.data.categorie === categorie.slug);
// Uitgelichte producten eerst.
const producten = alleProducten.sort((a, b) => Number(b.data.uitgelicht) - Number(a.data.uitgelicht));

// Grenzen van de prijsslider: op basis van de daadwerkelijke producten in
// déze categorie, zodat de slider nooit een breder bereik toont dan wat er
// te vinden is.
const prijzenMin = producten.map((p) => p.data.prijsMin);
const prijzenMax = producten.map((p) => p.data.prijsMax);
const minPrijs = prijzenMin.length ? Math.min(...prijzenMin) : 0;
const maxPrijs = prijzenMax.length ? Math.max(...prijzenMax) : 0;

// Alleen leeftijdsopties tonen die ook echt bij een product in deze
// categorie voorkomen -- anders kun je een optie aanvinken die altijd op
// "geen resultaten" uitkomt.
const LEEFTIJD_VOLGORDE = ['kind', 'tiener', 'volwassene', 'senior'] as const;
const aanwezigeLeeftijden = new Set(producten.flatMap((p) => p.data.leeftijd ?? []));
const beschikbareLeeftijden = LEEFTIJD_VOLGORDE.filter((l) => aanwezigeLeeftijden.has(l));
---

<BaseLayout title={categorie.metaTitle} description={categorie.metaDescription}>
  <section class="container categorie-intro">
    {categorie.seizoensgebonden && <span class="badge">Seizoensgebonden — jaarlijks te verversen</span>}
    <h1>{categorie.titel}</h1>
    {categorie.intro.map((paragraaf: string) => <p>{paragraaf}</p>)}
  </section>

  <section class="container">
    {producten.length > 0 && (
      <CategoryFilters minPrijs={minPrijs} maxPrijs={maxPrijs} leeftijdOpties={beschikbareLeeftijden} />
    )}

    {
      producten.length > 0 ? (
        <div class="grid grid-producten" data-producten-grid>
          {producten.map((product) => <ProductCard product={product} />)}
        </div>
      ) : (
        <p class="geen-producten">
          Voor deze categorie zijn nog geen cadeau-ideeën toegevoegd. Voeg markdown-bestanden
          toe in <code>src/content/producten/{categorie.slug}/</code>.
        </p>
      )
    }
  </section>
</BaseLayout>

<style>
  .categorie-intro {
    padding-block: 2.5rem 1.5rem;
    max-width: 70ch;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .categorie-intro p {
    color: var(--color-text-muted);
  }

  .geen-producten {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .geen-producten code {
    background: var(--color-bg-alt);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }
</style>
